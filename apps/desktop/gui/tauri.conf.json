{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Flowlog",
	"version": "0.1.0",
	"identifier": "com.orivanta.flowlog-agent-gui",
	"build": {
		"frontendDist": "./ui"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "Flowlog",
				"width": 420,
				"height": 640,
				"minWidth": 360,
				"minHeight": 480,
				"resizable": true,
				"visible": true,
				"center": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["appimage", "deb"],
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"]
	}
}
