		"@flowlog/db": "workspace:*",
		"@flowlog/env": "workspace:*",
		"@flowlog/utils": "workspace:*",
		"@hono/node-server": "^2.0.12",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"ai": "catalog:",
		"better-auth": "catalog:",
		"dotenv": "catalog:",
		"evlog": "catalog:",
		"hono": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@flowlog/config": "workspace:*",
